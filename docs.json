{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PAM Developer Docs",
  "description": "Memory MCP and Developer API documentation for PAM — connect external agents to company memory.",
  "colors": {
    "primary": "#8c20f8",
    "light": "#a855f7",
    "dark": "#6b16c4"
  },
  "fonts": {
    "family": "Inter"
  },
  "appearance": {
    "default": "light"
  },
  "css": "custom.css",
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "api": {
    "baseUrl": "https://api.pam.harmix.ai",
    "auth": {
      "method": "bearer"
    },
    "playground": {
      "display": "interactive"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Memory MCP",
        "href": "https://pam.harmix.ai/for-developers"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open PAM",
      "href": "https://pam.harmix.ai"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Memory MCP",
          "href": "https://pam.harmix.ai/for-developers",
          "icon": "rocket"
        }
      ]
    },
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Memory MCP",
            "groups": [
              {
                "group": "Getting started",
                "pages": [
                  "introduction",
                  "quickstart",
                  "setup-and-keys",
                  "client-setup"
                ]
              },
              {
                "group": "Reference",
                "pages": [
                  "mcp-reference",
                  "retrieve-memory",
                  "quotas-and-limits",
                  "error-codes"
                ]
              }
            ]
          },
          {
            "tab": "Developer API",
            "pages": [
              "developer-api-overview",
              {
                "group": "Endpoints",
                "openapi": "openapi/developer-api.yaml",
                "pages": [
                  "GET /v1/dev/readiness",
                  "GET /v1/dev/mcp-config",
                  "GET /v1/dev/mcp-usage-stats",
                  "GET /v1/dev/mcp-requests",
                  "GET /v1/dev/mcp-requests/{request_id}",
                  "POST /v1/dev/rotate-key",
                  "POST /v1/dev/revoke-key"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "uk",
        "tabs": [
          {
            "tab": "Memory MCP",
            "groups": [
              {
                "group": "Початок роботи",
                "pages": [
                  "uk/introduction",
                  "uk/quickstart",
                  "uk/setup-and-keys",
                  "uk/client-setup"
                ]
              },
              {
                "group": "Довідник",
                "pages": [
                  "uk/mcp-reference",
                  "uk/retrieve-memory",
                  "uk/quotas-and-limits",
                  "uk/error-codes"
                ]
              }
            ]
          },
          {
            "tab": "API для розробників",
            "pages": [
              "uk/developer-api-overview",
              {
                "group": "Endpoints",
                "openapi": "openapi/developer-api.yaml",
                "pages": [
                  "GET /v1/dev/readiness",
                  "GET /v1/dev/mcp-config",
                  "GET /v1/dev/mcp-usage-stats",
                  "GET /v1/dev/mcp-requests",
                  "GET /v1/dev/mcp-requests/{request_id}",
                  "POST /v1/dev/rotate-key",
                  "POST /v1/dev/revoke-key"
                ]
              }
            ]
          }
        ],
        "navbar": {
          "links": [
            {
              "label": "Memory MCP",
              "href": "https://pam.harmix.ai/for-developers"
            }
          ],
          "primary": {
            "type": "button",
            "label": "Відкрити PAM",
            "href": "https://pam.harmix.ai"
          }
        }
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://harmix.ai"
    }
  }
}
